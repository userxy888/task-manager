# 复制本文件为 .env 后填入 Supabase 项目信息
# 获取位置：Supabase 控制台 → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co

# 二选一：
# 1) publishable / anon key（前端同款，受 RLS 策略约束，需要先执行 supabase/policies.sql）
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# 2) secret / service_role key（服务端专用，绕过 RLS，切勿写进前端或提交到仓库）
# SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 服务端口（可选，默认 3000）
PORT=3000
